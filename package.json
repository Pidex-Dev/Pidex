{
  "name": "pidex",
  "private": true,
  "version": "0.2.0-beta.8",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/agent",
    "apps/auth-broker",
    "apps/desktop/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "scripts": {
    "desktop:css:check": "bun run --cwd apps/desktop/renderer css:check",
    "dev": "bun run scripts/Dev.ts",
    "dev:agent": "bun run scripts/DevAgent.ts",
    "dev:desktop": "bun run scripts/DevDesktop.ts",
    "test:unit": "bun test --parallel=8 --max-concurrency=1 --timeout=30000",
    "test:governance": "bun test scripts/contracts/CheckArchContracts.test.ts scripts/contracts/CheckLintRatchet.test.ts scripts/feature-map/FeatureMap.test.ts specs/tla/CheckTlaSpecs.test.ts scripts/formal/StateMachineProperty.test.ts apps/desktop/renderer/test/EffectPrimitives.test.tsx",
    "hooks:install": "bun run scripts/InstallGitHooks.ts",
    "lint:ratchet": "bun run scripts/contracts/CheckLintRatchet.ts",
    "arch:check": "bun run scripts/contracts/CheckArchContracts.ts",
    "feature-map:check": "bun run scripts/feature-map/CheckFeatureMap.ts",
    "formal:check": "bun run specs/tla/CheckTlaSpecs.ts",
    "app:drive": "bun run scripts/feature-map/AppDriver.ts",
    "check:quality": "bun run version:check && bun run typecheck && bun run format:check && bun run lint && bun run lint:ratchet && bun run arch:check && bun run feature-map:check && bun run formal:check && bun run --cwd packages/material-icon-theme sync:check && bun run desktop:css:check",
    "check:release": "bun run check:quality && bun run test:unit && bun run security:audit && bun run --cwd apps/desktop/renderer test:a11y && bun run package:win",
    "security:audit": "bun scripts/security/SecurityAudit.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "typecheck": "bun run --cwd packages/material-icon-theme typecheck && bun run --cwd packages/model-schema typecheck && bun run --cwd packages/shared typecheck && bun run --cwd packages/agent-protocol typecheck && bun run --cwd packages/session-view typecheck && bun run --cwd apps/auth-broker typecheck && bun run --cwd apps/agent typecheck && bun run --cwd apps/desktop/renderer typecheck && bun run --cwd apps/desktop/electron typecheck",
    "build:renderer": "bun run --cwd apps/desktop/renderer build",
    "build:agent": "bun run --cwd apps/agent build",
    "build:desktop": "bun run --cwd apps/desktop/electron build",
    "test:desktop:smoke": "bun run --cwd apps/desktop/electron test:smoke",
    "perf:renderer": "bun scripts/performance/RunSuite.ts --suite=renderer --enforce",
    "perf:electron": "bun scripts/performance/RunSuite.ts --suite=electron --enforce",
    "test:plan": "bun scripts/TestPlanFlow.ts",
    "test:review-concurrency": "bun scripts/TestReviewConcurrency.ts",
    "build": "bun run scripts/Build.ts",
    "package:win": "bun scripts/PackageWin.ts --x64",
    "version:check": "bun scripts/VersionPolicy.ts version:check",
    "version:prepare": "bun scripts/VersionPolicy.ts version:prepare",
    "lint": "oxlint --config .oxlintrc.json apps packages scripts"
  },
  "devDependencies": {
    "@pidex/shared": "workspace:*",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.11",
    "browserslist": "4.28.7",
    "dompurify": "3.4.17",
    "extract-zip": "file:./vendor/extract-zip",
    "fast-uri": "3.1.7",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "tar": "7.5.21",
    "toml": "5.0.1",
    "undici": "8.12.3",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "prosemirror-view": "1.43.0"
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "virtua@0.55.0": "patches/virtua@0.55.0.patch"
  }
}
