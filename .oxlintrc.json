{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "jsPlugins": [
    "./scripts/contracts/ModelSelectorLintPlugin.mjs",
    "./scripts/contracts/StartupCompatibilityLintPlugin.mjs",
    "./scripts/contracts/DesktopRegressionLintPlugin.mjs"
  ],
  "rules": {
    "pidex-models/preserve-configured-models": "error",
    "no-constant-condition": "error",
    "no-empty-pattern": "error",
    "no-irregular-whitespace": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-expressions": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "oxc/const-comparisons": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/jsx-key": "error",
    "react/no-did-update-set-state": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/rules-of-hooks": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-mutable-exports": "error",
    "import/no-amd": "error",
    "import/no-webpack-loader-syntax": "error",
    "import/no-absolute-path": "error",
    "import/no-duplicates": "warn"
  },
  "overrides": [
    {
      "files": [
        "apps/desktop/renderer/src/features/settings/ArchivedConversations*.ts*",
        "apps/desktop/renderer/src/services/desktop-client/AgentSessionClient.ts",
        "apps/agent/src/transport/rpc/handlers/Thread.ts",
        "apps/agent/src/session/ThreadHistoryService.ts"
      ],
      "rules": {
        "pidex-regressions/guard-archived-deletion": "error"
      }
    },
    {
      "files": ["apps/desktop/electron/src/settings/AppearanceSettingsStore.ts"],
      "rules": {
        "pidex-regressions/preserve-corrupt-appearance": "error"
      }
    },
    {
      "files": ["apps/desktop/renderer/src/features/speech/VoiceRecordingCache.ts"],
      "rules": {
        "pidex-regressions/preserve-typing-shortcuts": "error"
      }
    },
    {
      "files": ["apps/desktop/electron/src/terminal/ShellProfileService.ts"],
      "rules": {
        "pidex-regressions/discover-user-git-bash": "error"
      }
    },
    {
      "files": [
        "apps/desktop/renderer/src/features/automation/**/*.ts",
        "apps/desktop/renderer/src/features/automation/**/*.tsx",
        "apps/desktop/renderer/src/features/layout/sidebar/SidebarScheduledPane.tsx"
      ],
      "rules": {
        "pidex-regressions/use-interface-date-locale": "error"
      }
    },
    {
      "files": [
        "apps/agent/src/provider/ProviderError.ts",
        "apps/agent/src/provider/ModelHealthService.ts",
        "apps/agent/src/provider/runtime/ModelListing.ts",
        "apps/agent/src/provider/runtime/ModelService.ts"
      ],
      "rules": {
        "pidex-regressions/use-response-status": "error"
      }
    },
    {
      "files": [
        "apps/agent/src/project/ProjectSourceService.ts",
        "apps/agent/src/storage/repositories/ProjectRepository.ts",
        "apps/agent/src/storage/repositories/ExecutionRepository.ts",
        "apps/agent/src/provider/runtime/ModelService.ts"
      ],
      "rules": { "pidex-compat/no-retired-agent-entry": "error" }
    },
    {
      "files": ["apps/agent/src/provider/runtime/ProviderConfigMigration.ts"],
      "rules": { "pidex-compat/builtin-migration-schema": "error" }
    },
    {
      "files": ["apps/desktop/electron/src/settings/DataLocationStore.ts"],
      "rules": { "pidex-compat/data-location-default-on-enoent": "error" }
    },
    {
      "files": [
        "apps/desktop/renderer/src/main.tsx",
        "apps/desktop/renderer/src/features/routing/ConnectionLostPage.tsx"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "retryStartup",
            "message": "Select recovery through startupRecoveryActions(snapshot)."
          },
          {
            "property": "retryDataLocation",
            "message": "Select recovery through startupRecoveryActions(snapshot)."
          },
          {
            "property": "restoreDataLocation",
            "message": "Select recovery through startupRecoveryActions(snapshot)."
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/renderer/src/features/workspace/UseWorkspaceState.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "getAuthStatus",
            "message": "Workspace state must not fetch unused authentication status."
          },
          {
            "property": "getRuntimeStatus",
            "message": "Workspace state must not poll unused runtime status."
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop/renderer/shared/Types.ts",
        "apps/desktop/renderer/src/services/desktop-client/**/*.ts"
      ],
      "rules": { "pidex-compat/no-retired-desktop-member": "error" }
    },
    {
      "files": [
        "apps/desktop/electron/src/**/*.ts",
        "apps/desktop/electron/src/**/*.cts",
        "packages/shared/src/DesktopAppearanceIpc.ts"
      ],
      "rules": { "pidex-compat/no-retired-appearance-channel": "error" }
    },
    {
      "files": ["apps/desktop/renderer/shared/**/*.ts"],
      "rules": { "pidex-compat/no-retired-desktop-bridge": "error" }
    },
    {
      "files": ["apps/desktop/renderer/src/**/*.ts", "apps/desktop/renderer/src/**/*.tsx"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Renderer source must not import Electron directly; use the typed preload bridge."
              },
              {
                "name": "@pidex/agent",
                "message": "Renderer source must not import @pidex/agent directly; use @pidex/agent-protocol or @pidex/shared."
              },
              {
                "name": "@pidex/desktop-electron",
                "message": "Renderer source must not import Electron main-process code."
              }
            ],
            "patterns": [
              {
                "group": ["node:*", "**/apps/desktop/electron/**", "**/apps/agent/**"],
                "message": "Renderer source must stay browser-safe and decoupled from Electron/Agent internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop/electron/**/*.ts",
        "apps/desktop/electron/**/*.cts",
        "apps/desktop/electron/**/*.mts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pidex/renderer",
                "message": "Electron must not import @pidex/renderer; only apps/desktop/renderer/shared is allowed."
              }
            ],
            "patterns": [
              {
                "group": ["**/renderer/src/**"],
                "message": "Electron must not import apps/desktop/renderer/src; use apps/desktop/renderer/shared or @pidex/*."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/agent/**/*.ts", "apps/agent/**/*.mts", "apps/agent/**/*.cts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Agent runtime must not depend on Electron."
              },
              {
                "name": "react",
                "message": "Agent runtime must not depend on React."
              },
              {
                "name": "react-dom",
                "message": "Agent runtime must not depend on react-dom."
              },
              {
                "name": "@pidex/desktop-electron",
                "message": "Agent runtime must not import apps/desktop."
              },
              {
                "name": "@pidex/renderer",
                "message": "Agent runtime must not import apps/desktop/renderer."
              }
            ],
            "patterns": [
              {
                "group": ["**/apps/desktop/**"],
                "message": "Agent runtime must never import from apps/desktop/**."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/model-schema/src/*.ts"],
      "rules": {
        "import/no-self-import": "off"
      }
    },
    {
      "files": ["packages/**/*.ts", "packages/**/*.tsx", "packages/**/*.mts", "packages/**/*.cts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Shared packages must not depend on Electron."
              },
              {
                "name": "react",
                "message": "Shared packages must not depend on React."
              },
              {
                "name": "react-dom",
                "message": "Shared packages must not depend on react-dom."
              },
              {
                "name": "@pidex/agent",
                "message": "Shared packages must not depend on apps/agent."
              },
              {
                "name": "@pidex/desktop-electron",
                "message": "Shared packages must not depend on apps/desktop."
              },
              {
                "name": "@pidex/renderer",
                "message": "Shared packages must not depend on apps/desktop/renderer."
              }
            ],
            "patterns": [
              {
                "group": ["**/apps/**"],
                "message": "Shared packages must never import from apps/**."
              }
            ]
          }
        ]
      }
    }
  ]
}
